<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="view.SidebarView"
      spacing="8">

    <Label text="Info" styleClass="result-header"/>
    <Label fx:id="lblAlgorithm" text="Algorithm : -" styleClass="result-value"/>
    <Label fx:id="lblHeuristic" text="Heuristic  : -" styleClass="result-value"/>

    <Label text="Legend" styleClass="result-header"/>
    <VBox fx:id="legendContainer" spacing="4"/>

</VBox>
